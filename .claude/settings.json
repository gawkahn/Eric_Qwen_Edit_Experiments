{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-ai-disclosure.sh",
            "if": "Bash(git commit *)",
            "statusMessage": "Checking AI-disclosure trailer..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/require-typecheck-clean.sh",
            "if": "Bash(git commit *)",
            "statusMessage": "Type-check ratchet (pyright, ~11s)..."
          }
        ]
      }
    ]
  }
}
